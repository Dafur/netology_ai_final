# ============================================================================
# YandexGPT
# ============================================================================
# Авторизация: укажите либо API-ключ, либо IAM-токен
YANDEX_GPT_API_KEY=
YANDEX_GPT_IAM_TOKEN=
# Идентификатор каталога Yandex Cloud (обязателен)
YANDEX_GPT_FOLDER_ID=
# Модель и её версия
YANDEX_GPT_MODEL=yandexgpt-lite
YANDEX_GPT_MODEL_VERSION=latest
YANDEX_GPT_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
# Параметры генерации
YANDEX_GPT_TEMPERATURE=0.3
YANDEX_GPT_MAX_TOKENS=1000

# ============================================================================
# Таймауты запроса к YandexGPT, секунды
# ============================================================================
REQUEST_TIMEOUT=30
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=30
LLM_WRITE_TIMEOUT=10
LLM_POOL_TIMEOUT=5

# ============================================================================
# Fallback при недоступности модели
# ============================================================================
# true  — при сетевой ошибке/таймауте вернуть безопасный ответ (HTTP 200)
# false — вернуть ошибку (HTTP 503/504)
LLM_FALLBACK_ENABLED=true

# ============================================================================
# Кэширование результатов LLM (в памяти процесса)
# ============================================================================
CACHE_ENABLED=true
# Время жизни записи в секундах (10 минут)
CACHE_TTL=600
# Максимальное число записей; при превышении вытесняются давно использованные
CACHE_MAX_ENTRIES=1000

# ============================================================================
# Логирование
# ============================================================================
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# true — структурированный JSON, false — человекочитаемый формат
LOG_JSON=true
# Файл логов (создаётся автоматически); пустое значение отключает запись
LOG_FILE=logs/app.log
# Ротация: максимальный размер файла в байтах (10 МБ) и число копий
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
